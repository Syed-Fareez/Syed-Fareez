qpdf --password="123456" --decrypt patient_report_1.pdf patient_report_1_decrypted.pdf
qpdf --password="password" --decrypt patient_report_2.pdf patient_report_2_decrypted.pdf
qpdf --password='!@#$%^&' --decrypt patient_report_3.pdf patient_report_3_decrypted.pdf

